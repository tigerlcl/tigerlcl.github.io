---
import { translator, type Locale } from '../../i18n/ui';
import { conferences } from '../../data/conferences';
import type { CollectionEntry } from 'astro:content';
interface Props { publications: CollectionEntry<'publications'>[]; locale?: Locale; }
const { publications, locale = 'en' } = Astro.props;
const t = translator(locale);
const categories = ['All', 'AI / LLMs', 'AI for Finance'];
---
<section id="publications" class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
  <div class="mb-8 flex flex-col justify-between gap-5 lg:flex-row lg:items-end">
    <div>
      <p class="aurora-kicker mb-3 text-xs font-bold uppercase tracking-[0.34em]">{t("Research")}</p>
      <h2 class="aurora-heading font-serif text-4xl tracking-[-0.04em] sm:text-5xl">{t("Selected publications")}</h2>
      <p class="mt-4 text-sm text-zinc-600 dark:text-mist">{t("3 conference papers \u00b7 2 workshop papers \u00b7 First / co-first author")}</p>
      <p class="mt-2 text-xs text-zinc-500 dark:text-mist">{t("* Equal contribution")}</p>
    </div>
    <div class="flex flex-wrap gap-2" data-publication-filters aria-label={t("Filter publications")}>
      {categories.map((category) => (
        <button class="filter-pill" data-filter={category} aria-pressed={category === 'All'}>{t(category)}</button>
      ))}
    </div>
  </div>
  <div class="grid grid-cols-1 gap-5" data-publication-list>
    {publications.map(({ data }) => (
      <article class="publication-card paper-block" data-category={data.category}>
        <div class="paper-meta">
          <div class="flex h-20 w-36 shrink-0 items-center justify-center rounded-lg bg-white p-3">
            <img src={conferences[data.conference].logo} alt={`${conferences[data.conference].name} logo`} class="max-h-full max-w-full object-contain" loading="lazy" />
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-zinc-600 dark:text-mist">{data.venueShort.replace(/ 2025$/, '')} · {data.year}</p>
            <p class="mt-2 text-xs leading-5 text-zinc-500 dark:text-mist">{locale === 'zh' ? conferences[data.conference].cityZh : conferences[data.conference].city}</p>
            <a href={data.links.pdf} target="_blank" rel="noreferrer" aria-label={`${t('Read paper')}: ${data.title}`} class="nav-link mt-3 inline-block text-sm font-semibold">{t('Read paper')} ↗</a>
          </div>
        </div>
        <div class="min-w-0">
        <h3 class="font-serif text-2xl leading-tight tracking-[-0.03em] lg:text-3xl">
          <a href={data.links.pdf} target="_blank" rel="noreferrer" class="hover:underline underline-offset-4">{data.title}</a>
        </h3>
        <p class="mt-4 text-sm leading-6 text-zinc-600 dark:text-mist">
          {data.authors.map((author, index) => (
            <>
              {author === data.myName ? <strong class="font-semibold text-zinc-950 dark:text-white">{author}</strong> : author}{data.equalContribution.includes(author) && <sup>*</sup>}{index < data.authors.length - 1 ? ', ' : ''}
            </>
          ))}
        </p>
        <p class="mt-3 text-sm italic leading-6 text-zinc-500 dark:text-mist">{data.venue}</p>
        {data.note && <p class="mt-3 text-xs font-semibold text-zinc-700 dark:text-zinc-200">{data.note === 'Oral Paper Award' ? data.note : t(data.note)}</p>}

        </div>
      </article>
    ))}
  </div>
</section>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-publication-filters] button');
  const cards = document.querySelectorAll<HTMLElement>('[data-publication-list] [data-category]');

  filters.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      filters.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      cards.forEach((card) => {
        card.hidden = filter !== 'All' && card.dataset.category !== filter;
      });
    });
  });
</script>
