---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Locale } from '../../i18n/ui';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../../../public/images/gallery/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}',
  { eager: true },
);
const descriptions: Record<string, { en: string; zh: string }> = {
  '1.jpg': { en: 'Sharing ideas during a seated discussion', zh: '在座谈中交流想法' },
  '2.jpg': { en: 'Speaking at a workshop beside a whiteboard', zh: '在工作坊的白板旁分享' },
  '3.jpg': { en: 'A moment at a conference', zh: '学术会议上的留影' },
  '4.jpg': { en: 'Speaking at an entrepreneurship event', zh: '在创业活动中分享' },
};
const photos = Object.entries(images)
  .sort(([a], [b]) => a.localeCompare(b, 'en', { numeric: true }))
  .map(([path, image], index) => {
    const filename = path.split('/').pop()!;
    return {
      image: image.default,
      original: `/images/gallery/${encodeURIComponent(filename)}`,
      alt: descriptions[filename]?.[locale] ?? (locale === 'zh' ? `个人照片 ${index + 1}` : `Personal photo ${index + 1}`),
    };
  });
---
{photos.length > 0 && (
  <aside class="hero-gallery" data-gallery aria-label={locale === 'zh' ? '个人相册' : 'Personal gallery'} aria-roledescription={locale === 'zh' ? '轮播图' : 'carousel'}>
    <div class="gallery-window">
      <div class="gallery-track" data-gallery-track>
        {photos.map((photo, index) => (
          <div class="gallery-slide" data-gallery-slide role="group" aria-roledescription={locale === 'zh' ? '照片' : 'slide'} aria-label={`${index + 1} / ${photos.length}`} aria-hidden={index !== 0 ? 'true' : undefined}>
            <a href={photo.original} target="_blank" rel="noreferrer" tabindex={index === 0 ? 0 : -1} aria-label={`${photo.alt} — ${locale === 'zh' ? '查看完整照片（在新标签页打开）' : 'View full photo (opens in a new tab)'}`}>
              <Image
                src={photo.image}
                alt={photo.alt}
                width={1200}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1280px) 313.6px, (min-width: 1024px) 26.6vw, (min-width: 640px) 403.2px, calc(70vw - 28px)"
                format="webp"
                quality={82}
                loading={index < 2 ? 'eager' : 'lazy'}
                class="h-full w-full object-cover"
              />
              <span class="gallery-open" aria-hidden="true">↗</span>
            </a>
          </div>
        ))}
      </div>
    </div>
    {photos.length > 1 && (
      <div class="gallery-controls" data-gallery-controls hidden>
        <button type="button" class="gallery-button" data-gallery-prev aria-label={locale === 'zh' ? '上一张照片' : 'Previous photo'}>←</button>
        <div class="gallery-dots" aria-label={locale === 'zh' ? '选择照片' : 'Choose photo'}>
          {photos.map((_, index) => (
            <button type="button" class="gallery-dot" data-gallery-dot={index} aria-label={locale === 'zh' ? `显示第 ${index + 1} 张照片` : `Show photo ${index + 1}`} aria-current={index === 0 ? 'true' : undefined}><span /></button>
          ))}
        </div>
        <button type="button" class="gallery-button gallery-pause" data-gallery-pause data-pause-label={locale === 'zh' ? '暂停自动播放' : 'Pause slideshow'} data-play-label={locale === 'zh' ? '开始自动播放' : 'Play slideshow'} aria-label={locale === 'zh' ? '暂停自动播放' : 'Pause slideshow'} aria-pressed="false"><span aria-hidden="true">Ⅱ</span></button>
        <button type="button" class="gallery-button" data-gallery-next aria-label={locale === 'zh' ? '下一张照片' : 'Next photo'}>→</button>
      </div>
    )}
  </aside>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>('[data-gallery-track]')!;
    const slides = Array.from(track.querySelectorAll<HTMLElement>('[data-gallery-slide]'));
    if (slides.length < 2) return;
    const dots = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-dot]'));
    const pause = gallery.querySelector<HTMLButtonElement>('[data-gallery-pause]')!;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let paused = motion.matches;
    let position = 1;
    let current = 0;
    let moving = false;
    let inView = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let settleTimer: ReturnType<typeof setTimeout> | undefined;

    // End copies let the last photo slide forward into the first without rewinding.
    const clone = (slide: HTMLElement) => {
      const copy = slide.cloneNode(true) as HTMLElement;
      copy.removeAttribute('data-gallery-slide');
      copy.setAttribute('aria-hidden', 'true');
      copy.inert = true;
      copy.querySelectorAll('img').forEach((img) => { img.loading = 'eager'; });
      return copy;
    };
    track.prepend(clone(slides[slides.length - 1]));
    track.append(clone(slides[0]));
    track.style.transform = 'translateX(-100%)';
    gallery.querySelector<HTMLElement>('[data-gallery-controls]')!.hidden = false;

    const schedule = () => {
      clearTimeout(timer);
      if (!paused && !moving && inView && !document.hidden && !gallery.matches(':hover, :focus-within')) {
        timer = setTimeout(() => show(position + 1), 3000);
      }
    };
    const render = () => {
      current = (position - 1 + slides.length) % slides.length;
      slides.forEach((slide, index) => {
        slide.setAttribute('aria-hidden', String(index !== current));
        slide.inert = index !== current;
        slide.querySelector('a')!.tabIndex = index === current ? 0 : -1;
      });
      dots.forEach((dot, index) => {
        if (index === current) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };
    const settle = () => {
      clearTimeout(settleTimer);
      if (position === 0 || position === slides.length + 1) {
        position = position === 0 ? slides.length : 1;
        track.style.transition = 'none';
        track.style.transform = `translateX(-${position * 100}%)`;
      }
      moving = false;
      schedule();
    };
    const show = (next: number) => {
      if (moving || next === position) return;
      clearTimeout(timer);
      position = next;
      moving = true;
      track.style.transition = motion.matches ? 'none' : 'transform 650ms cubic-bezier(0.22, 1, 0.36, 1)';
      track.style.transform = `translateX(-${position * 100}%)`;
      render();
      if (motion.matches) settle();
      else settleTimer = setTimeout(settle, 750);
    };
    const renderPause = () => {
      pause.setAttribute('aria-pressed', String(paused));
      pause.setAttribute('aria-label', (paused ? pause.dataset.playLabel : pause.dataset.pauseLabel)!);
      pause.querySelector('span')!.textContent = paused ? '▶' : 'Ⅱ';
      schedule();
    };

    track.addEventListener('transitionend', (event) => {
      if (event.target === track && event.propertyName === 'transform') settle();
    });
    gallery.querySelector('[data-gallery-prev]')!.addEventListener('click', () => show(position - 1));
    gallery.querySelector('[data-gallery-next]')!.addEventListener('click', () => show(position + 1));
    dots.forEach((dot, index) => dot.addEventListener('click', () => show(index + 1)));
    pause.addEventListener('click', () => { paused = !paused; renderPause(); });
    gallery.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        show(position + (event.key === 'ArrowRight' ? 1 : -1));
      }
    });
    gallery.addEventListener('pointerenter', schedule);
    gallery.addEventListener('pointerleave', schedule);
    gallery.addEventListener('focusin', schedule);
    gallery.addEventListener('focusout', () => requestAnimationFrame(schedule));
    document.addEventListener('visibilitychange', schedule);
    motion.addEventListener('change', () => { paused = motion.matches; renderPause(); });
    new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; schedule(); }, { threshold: 0.25 }).observe(gallery);
    render();
    renderPause();
  });
</script>

<style>
  .hero-gallery { width: 100%; max-width: 36rem; margin-inline: auto; align-self: center; min-width: 0; }
  .gallery-window { width: 70%; margin-inline: auto; overflow: hidden; aspect-ratio: 4 / 5; border-radius: 1.25rem; background: var(--alabaster-grey); box-shadow: 0 12px 36px rgb(20 33 61 / 10%); }
  .gallery-track { display: flex; height: 100%; }
  .gallery-slide { flex: 0 0 100%; min-width: 0; height: 100%; }
  .gallery-slide a { position: relative; display: block; height: 100%; }
  .gallery-slide :global(img) { object-position: center 35%; }
  .gallery-slide a:focus-visible { outline: 3px solid var(--orange); outline-offset: -5px; }
  .gallery-open { position: absolute; right: 1rem; bottom: 1rem; display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: rgb(255 255 255 / 90%); color: var(--prussian-blue); }
  .gallery-controls { display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-top: 1rem; }
  .gallery-controls[hidden] { display: none; }
  .gallery-button, .gallery-dot { display: grid; place-items: center; height: 2.75rem; border-radius: 50%; color: inherit; }
  .gallery-button { width: 2.75rem; border: 1px solid rgb(128 128 128 / 25%); background: rgb(128 128 128 / 5%); }
  .gallery-button:hover { border-color: var(--orange); }
  .gallery-button:focus-visible, .gallery-dot:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }
  .gallery-dots { display: flex; align-items: center; }
  .gallery-dot { width: 1.75rem; }
  .gallery-dot span { width: 0.375rem; height: 0.375rem; border-radius: 99px; background: currentColor; opacity: 0.25; transition: width 250ms, opacity 250ms; }
  .gallery-dot[aria-current='true'] span { width: 1.25rem; background: var(--orange); opacity: 1; }
  .gallery-pause { font-size: 0.75rem; }
  @media (min-width: 1024px) { .hero-gallery { max-width: 28rem; justify-self: end; } }
  @media (prefers-reduced-motion: reduce) { .gallery-dot span { transition: none; } }
</style>
