---
import SectionHeading from './SectionHeading.astro';

const items = [
  { period: '2025 - Present', title: 'Founder & CEO', org: 'Paradoox AI', detail: 'Building trustworthy AI products for fund investment.', logo: '/logos/paradoox_ai.png', logoAlt: 'Paradoox AI logo', logoClass: 'h-8 w-8' },
  { period: '2024 - Present', title: 'Ph.D. Candidate', org: 'HKUST(GZ), Data Science and Analytics Thrust', detail: 'Applied AI, LLM data systems, and trustworthy investment intelligence.', logo: '/logos/hkust.svg', logoAlt: 'HKUST logo', logoClass: 'h-9 w-6' },
  { period: '2020 - 2024', title: 'Data Scientist', org: 'Measurable AI', detail: 'Derived consumer insights from transactional data across emerging markets.', logo: '/logos/measurable_ai.jpeg', logoAlt: 'Measurable AI logo', logoClass: 'h-8 w-8 rounded-md' },
  { period: '2017 - 2018', title: 'Exchange Student', org: 'Tsinghua University', detail: 'Studied in Electrionic Engineering.', logo: '/logos/tsinghua.png', logoAlt: 'Tsinghua University logo', logoClass: 'h-9 w-9' },
  { period: '2016 - 2020', title: 'B.Eng. Information Engineering', org: 'The Chinese University of Hong Kong', detail: 'Minor in Computer Science.', logo: '/logos/cuhk.png', logoAlt: 'CUHK logo', logoClass: 'h-9 w-9' },
];
---
<section id="experience" class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
  <SectionHeading eyebrow="Experience" title="Research and engineering trajectory." />
  <div class="relative border-l border-zinc-200 pl-10 dark:border-line">
    {items.map((item) => (
      <article class="relative pb-10 last:pb-0">
        <span class="absolute -left-16 top-0 flex h-12 w-12 items-center justify-center rounded-full border border-zinc-200 bg-white shadow-sm ring-4 ring-zinc-50 dark:border-line dark:bg-white dark:ring-ink">
          <img src={item.logo} alt={item.logoAlt} class:list={['object-contain', item.logoClass]} loading="lazy" />
        </span>
        <p class="text-xs font-bold uppercase tracking-[0.28em] text-zinc-500 dark:text-mist">{item.period}</p>
        <h3 class="mt-2 font-serif text-2xl tracking-[-0.03em]">{item.title}</h3>
        <p class="mt-1 text-sm font-semibold text-zinc-700 dark:text-zinc-200">{item.org}</p>
        <p class="mt-3 max-w-2xl text-sm leading-7 text-zinc-600 dark:text-mist">{item.detail}</p>
      </article>
    ))}
  </div>
</section>
